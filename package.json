{
  "name": "storagehub-load-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fmt": "biome format . --error-on-warnings",
    "fmt:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm util:resources:manifest",
    "build": "tsc -p tsconfig.json",
    "with-logs": "pnpm exec tsx scripts/run-scenario.ts --",
    "run:with-logs": "pnpm build && pnpm with-logs",
    "test:run": "pnpm run:with-logs artillery run",

    "test:unauth": "pnpm test:run scenarios/msp.unauth.yml",
    "test:examples.getProfile": "pnpm test:run scenarios/examples.getProfile.yml",
    "test:examples.createBucket": "pnpm test:run scenarios/examples.createBucket.yml",
    "test:examples.uploadFile": "pnpm test:run scenarios/examples.uploadFile.yml",
    "test:download": "pnpm test:run scenarios/download.yml",
    "util:fund-accounts": "pnpm exec tsx scripts/fund-accounts.ts",
    "util:resources:manifest": "pnpm exec tsx scripts/resources.ts"
  },
  "dependencies": {
    "@storagehub-sdk/core": "0.4.0",
    "@storagehub-sdk/msp-client": "0.4.0",
    "@polkadot/api": "^16.5.4",
    "artillery": "^2.0.0",
    "pino": "^10.1.0",
    "viem": "^2.42.1"
  },
  "pnpm": {
    "overrides": {
      "@polkadot/types": "16.5.4",
      "@polkadot/types-codec": "16.5.4",
      "@polkadot/types-create": "16.5.4",
      "@polkadot/util": "14.0.1",
      "@polkadot/util-crypto": "14.0.1",
      "@polkadot/x-randomvalues": "14.0.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.6.0",
    "@types/node": "^25.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
